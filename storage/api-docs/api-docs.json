        "/api/stripe/charges/create": {
            "post": {
                "tags": [
                    "Stripe"
                ],
                "summary": "Create a new charge",
                "description": "Creates a new charge in Stripe.",
                "operationId": "createCharge",
                "requestBody": {
                    "description": "Charge data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "amount",
                                    "currency",
                                    "source"
                                ],
                                "properties": {
                                    "amount": {
                                        "description": "Amount in cents",
                                        "type": "integer",
                                        "example": 1000
                                    },
                                    "currency": {
                                        "description": "ISO 4217 currency code",
                                        "type": "string",
                                        "example": "brl"
                                    },
                                    "source": {
                                        "description": "Stripe payment source token",
                                        "type": "string",
                                        "example": "tok_visa"
                                    },
                                    "metadata": {
                                        "description": "Additional metadata",
                                        "type": "object",
                                        "example": {
                                            "order_id": "123",
                                            "customer_id": "456"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Charge created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "example": "ch_3MtwBwLkdIwHu7ix0snN0B15"
                                        },
                                        "amount": {
                                            "type": "integer",
                                            "example": 1000
                                        },
                                        "currency": {
                                            "type": "string",
                                            "example": "brl"
                                        },
                                        "status": {
                                            "type": "string",
                                            "example": "succeeded"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                }
            }
        },
